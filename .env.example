# =============================================================================
# Kenai Quest — variáveis de ambiente
#
# Copie este arquivo para `.env` na raiz do repositório e preencha os valores.
# NUNCA faça commit do arquivo `.env` (ele já está no .gitignore).
#
# Apenas variáveis com o prefixo VITE_ chegam ao navegador. Todas as demais
# ficam exclusivamente no backend.
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Defina como true quando o backend estiver atrás de um proxy reverso
# (Render, Railway, Fly.io, Nginx). Necessário para o rate limit ler o IP real.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
#
# Desenvolvimento local:
#   postgresql://kenai:kenai_dev_password@localhost:5432/kenai_quest
#
# Supabase (Project Settings > Database > Connection string > URI).
# Use a porta 6543 (Connection Pooler / Transaction mode) em ambientes
# serverless e a porta 5432 em servidores de longa duração:
#   postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://kenai:kenai_dev_password@localhost:5432/kenai_quest
# Defina como true ao conectar no Supabase ou em qualquer Postgres gerenciado.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Banco usado pelos testes de integração. Se não for definido, os testes de
# integração são ignorados e apenas os testes unitários rodam.
TEST_DATABASE_URL=postgresql://kenai:kenai_dev_password@localhost:5432/kenai_quest_test

# -----------------------------------------------------------------------------
# Autenticação
#
# Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo de 32 caracteres. Trocar este valor invalida todas as sessões.
# -----------------------------------------------------------------------------
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# CORS / cookies
#
# Origens permitidas do frontend, separadas por vírgula.
# Produção: https://seu-app.vercel.app
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Opcional. Defina apenas se o backend e o frontend compartilharem o mesmo
# domínio-pai (ex.: .kenaiquest.com).
# COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Armazenamento das artes
#
# STORAGE_DRIVER=local     -> grava em disco (desenvolvimento, sem credenciais)
# STORAGE_DRIVER=supabase  -> grava no Supabase Storage (produção)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Obrigatórias quando STORAGE_DRIVER=supabase.
# SUPABASE_SERVICE_ROLE_KEY é uma credencial de administrador: mantenha-a
# apenas no backend e nunca a exponha ao frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kenai-artworks

# -----------------------------------------------------------------------------
# Seed
#
# Caminho da arte inicial de desenvolvimento. Se o arquivo não existir, o seed
# avisa e segue sem cadastrar a arte.
# -----------------------------------------------------------------------------
SEED_ARTWORK_PATH=./client/public/brand/Kenai/KenPraia.png

# -----------------------------------------------------------------------------
# Frontend (client/.env) — somente estas chegam ao navegador
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
